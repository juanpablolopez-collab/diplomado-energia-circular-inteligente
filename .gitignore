# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Datos sensibles o generados (versionar solo ejemplos anonimizados)
datos/*
!datos/.gitkeep
!datos/README.md

# Modelos y pesos (no versionar binarios grandes)
modelos/*
!modelos/.gitkeep
!modelos/README.md
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt

# Activos generativos grandes: no se ignoran porque son entregables.
# Si superan el tamaño recomendado, usar Git LFS (git lfs track "*.glb", etc.).

# Entornos y secretos
.env
*.env
secrets.*

# Sistema operativo / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
